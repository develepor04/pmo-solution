# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production

# Azure Anthropic (optional)
AZURE_ANTHROPIC_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic/
AZURE_ANTHROPIC_DEPLOYMENT=your-deployment-name
AZURE_ANTHROPIC_API_KEY=your-azure-anthropic-api-key

# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
BACKEND_PORT=5000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Microsoft Graph API (Azure App Registration)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id

# Web Push (VAPID) — generate once; do not change after users subscribe
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_MAILTO=mailto:admin@example.com

# Deviation lifecycle
DEVIATION_REMINDER_DAYS=15
DEVIATION_EXPIRY_DAYS=20
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL (optional — can also live in database/.env)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deskon
DB_USER=postgres
DB_PASSWORD=your-db-password

# AI providers (optional)
GROQ_API_KEY=your-groq-api-key
GMAIL_APP_PASSWORD=your-gmail-app-password
AZURE_AGENTS_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_API_KEY=your-azure-ai-api-key
AZURE_AGENT_ID=your-azure-agent-id
